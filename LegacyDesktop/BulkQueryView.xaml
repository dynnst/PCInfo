<UserControl x:Class="PCNetworkInspector.Views.BulkQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PCNetworkInspector.Helpers"
             mc:Ignorable="d"
             Background="{StaticResource ContentBgBrush}">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Toplu Sorgulama"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,18"/>

        <!-- Input Card -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="IP ADRESLERİ / BİLGİSAYAR ADLARI"
                               Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding TargetList, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="120"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="12.5"
                             VerticalContentAlignment="Top"
                             ToolTip="Her satıra bir IP adresi veya bilgisayar adı girin"/>
                    <TextBlock Text="Her satıra bir IP adresi veya bilgisayar adı  (örn: 192.168.1.10 veya PC-001)"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11.5" Margin="2,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="SEÇENEKLER"
                               Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>
                    <TextBlock Text="Eş Zamanlı Bağlantı" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,4"/>
                    <ComboBox SelectedValue="{Binding MaxConcurrentConnections}"
                              SelectedValuePath="Tag"
                              FontSize="13" Height="34">
                        <ComboBoxItem Content="5 bağlantı" Tag="5"/>
                        <ComboBoxItem Content="10 bağlantı" Tag="10"/>
                        <ComboBoxItem Content="20 bağlantı" Tag="20"/>
                    </ComboBox>

                    <Separator Style="{StaticResource SeparatorStyle}"/>

                    <Button Content="▶  Tümünü Sorgula"
                            Command="{Binding StartCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="38" Margin="0,0,0,6"/>
                    <Button Content="⏹  İptal"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Height="38" Margin="0,0,0,6"/>
                    <Button Content="🗑  Temizle"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="38"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress / Stats -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <ProgressBar IsIndeterminate="{Binding IsBusy, Mode=OneWay}"
                                 Value="{Binding DoneCount, Mode=OneWay}"
                                 Maximum="{Binding TotalCount, Mode=OneWay}"
                                 Style="{StaticResource ModernProgressBarStyle}"
                                 Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ProgressText}"
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Content="📊 Excel"
                            Command="{Binding ExportExcelCommand}"
                            Style="{StaticResource SuccessButtonStyle}"
                            Padding="10,6" Margin="0,0,6,0"/>
                    <Button Content="📄 CSV"
                            Command="{Binding ExportCsvCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,6" Margin="0,0,6,0"/>
                    <Button Content="📑 PDF"
                            Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="10,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results Grid -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Results}"
                  SelectedItem="{Binding SelectedItem}"
                  Style="{StaticResource ModernDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                            <Setter Property="Background" Value="#FFEBEE"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusIcon}" Value="⏳">
                            <Setter Property="Background" Value="#FFF8E1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Durum" Binding="{Binding StatusIcon}" Width="60" MinWidth="50"/>
                <DataGridTextColumn Header="IP / Ad" Binding="{Binding Target}" Width="140"/>
                <DataGridTextColumn Header="Bilgisayar" Binding="{Binding ComputerName}" Width="140"/>
                <DataGridTextColumn Header="Üretici" Binding="{Binding Manufacturer}" Width="120"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="140"/>
                <DataGridTextColumn Header="Seri No" Binding="{Binding SerialNumber}" Width="120"/>
                <DataGridTextColumn Header="İşlemci" Binding="{Binding CpuName}" Width="200"/>
                <DataGridTextColumn Header="RAM" Binding="{Binding RamText}" Width="80"/>
                <DataGridTextColumn Header="İşletim Sistemi" Binding="{Binding OsCaption}" Width="160"/>
                <DataGridTextColumn Header="Durum Mesajı" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
