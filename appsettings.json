{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PCNetworkInventory;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"
  },
  "NetworkScanner": {
    "DefaultRange": "10.7.202.1 - 10.7.202.500",
    "MaxConcurrency": 30,
    "TimeoutMs": 1200
  },
  "Hikvision": {
    "DefaultUsername": "admin",
    "DefaultPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
