@model PCNetworkInspector.Services.InventoryDashboardStats
@{
    ViewData["Title"] = "Şube Müdürlüğü Envanter Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-building-gear text-primary me-2"></i>Şube Müdürlüğü Envanter & Donanım İstatistikleri</h3>
        <p class="text-muted mb-0">Bilgisayarlar, monitörler, kameralar, optik okuyucular, parmak izi cihazları ve çevre birimleri</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Inventory" asp-action="Index" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-box-seam"></i> Tüm Envanteri Yönet
        </a>
        <a asp-controller="Inventory" asp-action="ExportExcel" class="btn btn-outline-success d-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-excel"></i> Excel Raporu
        </a>
        <a asp-controller="Inventory" asp-action="ExportPdf" class="btn btn-outline-danger d-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-pdf"></i> PDF İndir
        </a>
    </div>
</div>

<!-- Main Asset Category Stat Cards -->
<div class="row g-3 mb-4">
    <!-- Bilgisayarlar -->
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card bg-white h-100 border-start border-primary border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">BİLGİSAYARLAR</span>
                    <h2 class="fw-bold my-1 text-primary">@(Model.TotalDesktopPc + Model.TotalLaptop)</h2>
                    <small class="text-muted">@Model.TotalDesktopPc Masaüstü | @Model.TotalLaptop Laptop</small>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                    <i class="bi bi-pc-display fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Monitörler -->
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card bg-white h-100 border-start border-info border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">MONİTÖRLER</span>
                    <h2 class="fw-bold my-1 text-info">@Model.TotalMonitors</h2>
                    <small class="text-muted">Kayıtlı ve bağlı ekranlar</small>
                </div>
                <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                    <i class="bi bi-display fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- IP Kameralar -->
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card bg-white h-100 border-start border-warning border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">IP KAMERALAR</span>
                    <h2 class="fw-bold my-1 text-warning">@Model.TotalCameras</h2>
                    <small class="text-muted">Hikvision & Güvenlik Kameraları</small>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                    <i class="bi bi-camera-video-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Optik Okuyucular -->
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card bg-white h-100 border-start border-success border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">OPTİK OKUYUCULAR</span>
                    <h2 class="fw-bold my-1 text-success">@Model.TotalOpticalReaders</h2>
                    <small class="text-muted">Sınav / OMR Form Okuyucuları</small>
                </div>
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                    <i class="bi bi-file-earmark-check-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Parmak İzi Cihazları (PDKS) -->
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card bg-white h-100 border-start border-danger border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">PARMAK İZİ / PDKS</span>
                    <h2 class="fw-bold my-1 text-danger">@Model.TotalFingerprintScanners</h2>
                    <small class="text-muted">Biyometrik Personel Cihazları</small>
                </div>
                <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle">
                    <i class="bi bi-fingerprint fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Yazıcılar -->
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card bg-white h-100 border-start border-secondary border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">YAZICILAR / TARAYICILAR</span>
                    <h2 class="fw-bold my-1 text-secondary">@Model.TotalPrinters</h2>
                    <small class="text-muted">Ağ ve Yerel Yazıcılar</small>
                </div>
                <div class="bg-secondary bg-opacity-10 text-secondary p-3 rounded-circle">
                    <i class="bi bi-printer-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- UPS Güç Kaynakları -->
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card bg-white h-100 border-start border-dark border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">UPS GÜÇ KAYNAKLARI</span>
                    <h2 class="fw-bold my-1 text-dark">@Model.TotalUps</h2>
                    <small class="text-muted">Kesintisiz Güç Kaynağı</small>
                </div>
                <div class="bg-dark bg-opacity-10 text-dark p-3 rounded-circle">
                    <i class="bi bi-battery-charging fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Ağ Cihazları (Switch/Router) -->
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card bg-white h-100 border-start border-primary border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">AĞ CİHAZLARI</span>
                    <h2 class="fw-bold my-1 text-primary">@Model.TotalNetworkDevices</h2>
                    <small class="text-muted">Switch, Router, Access Point</small>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                    <i class="bi bi-hdd-network-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Status Summary Row -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 d-flex justify-content-between align-items-center">
            <div>
                <small class="fw-bold text-success text-uppercase">KULLANIMDA / FAAL</small>
                <h4 class="fw-bold mb-0 text-success">@Model.TotalActive</h4>
            </div>
            <i class="bi bi-check-circle-fill text-success fs-2"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-3 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-3 d-flex justify-content-between align-items-center">
            <div>
                <small class="fw-bold text-primary text-uppercase">DEPODA / YEDEK</small>
                <h4 class="fw-bold mb-0 text-primary">@Model.TotalInStorage</h4>
            </div>
            <i class="bi bi-box2 text-primary fs-2"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-3 bg-warning bg-opacity-10 border border-warning border-opacity-25 rounded-3 d-flex justify-content-between align-items-center">
            <div>
                <small class="fw-bold text-warning-emphasis text-uppercase">ARIZALI / TAMİRDE</small>
                <h4 class="fw-bold mb-0 text-warning-emphasis">@Model.TotalInRepair</h4>
            </div>
            <i class="bi bi-tools text-warning fs-2"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-3 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded-3 d-flex justify-content-between align-items-center">
            <div>
                <small class="fw-bold text-danger text-uppercase">HURDA / HEK</small>
                <h4 class="fw-bold mb-0 text-danger">@Model.TotalScrapped</h4>
            </div>
            <i class="bi bi-trash3 text-danger fs-2"></i>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Location Breakdown -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-geo-alt text-danger me-2"></i>Mevki / Birim Bazlı Cihaz Dağılımı</span>
            </div>
            <div class="card-body p-0">
                @if (Model.LocationDistribution.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-geo-alt fs-2 text-secondary d-block mb-2"></i>
                        Henüz konum/mevki tanımlı cihaz yok.
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var loc in Model.LocationDistribution)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <span class="fw-semibold text-dark"><i class="bi bi-building me-2 text-secondary"></i>@loc.Key</span>
                                <span class="badge bg-primary rounded-pill fs-6 px-3">@loc.Value Cihaz</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <!-- Recent Assets Table -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-clock-history text-primary me-2"></i>Son İşlem Gören Donanım Kayıtları</span>
                <a asp-controller="Inventory" asp-action="Index" class="btn btn-sm btn-outline-primary">Tüm Envanter</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fotoğraf</th>
                                <th>Kategori</th>
                                <th>Cihaz / Model</th>
                                <th>Mevki / Yer</th>
                                <th>Zimmetli</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentAssets.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-2 text-secondary d-block mb-2"></i>
                                        Henüz kayıtlı cihaz bulunmuyor.<br />
                                        <a asp-controller="Inventory" asp-action="Index" class="btn btn-sm btn-primary mt-3">Yeni Donanım Ekle</a>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var asset in Model.RecentAssets)
                                {
                                    <tr>
                                        <td width="55">
                                            @if (!string.IsNullOrWhiteSpace(asset.ImagePath))
                                            {
                                                <img src="@asset.ImagePath" class="rounded border" style="width: 44px; height: 44px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light text-secondary rounded d-flex align-items-center justify-content-center border" style="width: 44px; height: 44px;">
                                                    <i class="bi @asset.Category.GetCategoryIcon() fs-5"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                <i class="bi @asset.Category.GetCategoryIcon() me-1"></i>
                                                @asset.Category.GetCategoryName()
                                            </span>
                                        </td>
                                        <td>
                                            <div class="fw-bold">@asset.Brand @asset.Model</div>
                                            <small class="text-muted font-monospace">SN: @(string.IsNullOrWhiteSpace(asset.SerialNumber) ? "—" : asset.SerialNumber)</small>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold text-dark">@asset.Location</div>
                                            <small class="text-muted">@(string.IsNullOrWhiteSpace(asset.RoomNumber) ? "" : $"Oda: {asset.RoomNumber}")</small>
                                        </td>
                                        <td>
                                            <span class="small fw-semibold text-primary">@(string.IsNullOrWhiteSpace(asset.AssignedPerson) ? "—" : asset.AssignedPerson)</span>
                                        </td>
                                        <td>
                                            <span class="@asset.Status.GetStatusBadgeClass()">@asset.Status.GetStatusName()</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
