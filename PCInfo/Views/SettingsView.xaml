<UserControl x:Class="PCNetworkInspector.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource ContentBgBrush}">

    <StackPanel Margin="24,20" MaxWidth="600" HorizontalAlignment="Left">

        <TextBlock Text="Ayarlar"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,20"/>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="BAĞLANTI AYARLARI" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Maks. Eş Zamanlı Bağlantı" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="Toplu sorgulama için paralel bağlantı sayısı"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" FontSize="13" Height="34"
                              SelectedValue="{Binding MaxConcurrentConnections}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="5 bağlantı" Tag="5"/>
                        <ComboBoxItem Content="10 bağlantı" Tag="10"/>
                        <ComboBoxItem Content="20 bağlantı" Tag="20"/>
                        <ComboBoxItem Content="50 bağlantı" Tag="50"/>
                    </ComboBox>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Bağlantı Zaman Aşımı (sn)" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="Her bilgisayar için maksimum bekleme süresi"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" FontSize="13" Height="34"
                              SelectedValue="{Binding ConnectionTimeoutSeconds}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="15 saniye" Tag="15"/>
                        <ComboBoxItem Content="30 saniye" Tag="30"/>
                        <ComboBoxItem Content="60 saniye" Tag="60"/>
                        <ComboBoxItem Content="120 saniye" Tag="120"/>
                    </ComboBox>
                </Grid>

                <Separator Style="{StaticResource SeparatorStyle}" Margin="0,16"/>

                <TextBlock Text="DIŞA AKTARMA" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Varsayılan Kayıt Klasörü" Style="{StaticResource LabelTextStyle}"/>
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Text="{Binding DefaultExportPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Grid.Column="2" Content="📂"
                            Height="34" Padding="10,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseFolderButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="UYGULAMA HAKKINDA" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
                <TextBlock Text="PC Network Inspector" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Sürüm 1.0.0" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,3,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    Windows ağındaki bilgisayarların donanım, işletim sistemi ve ağ bilgilerini
                    WMI/CIM üzerinden anlık olarak sorgular. Hiçbir veri yerel olarak saklanmaz.
                </TextBlock>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
