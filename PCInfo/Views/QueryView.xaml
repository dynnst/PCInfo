<UserControl x:Class="PCNetworkInspector.Views.QueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PCNetworkInspector.Helpers"
             mc:Ignorable="d"
             Background="{StaticResource ContentBgBrush}">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <local:NullToVisibilityConverter x:Key="NullToVis"/>
        <local:StringToVisibilityConverter x:Key="StrToVis"/>
        <local:TestResultToItemsConverter x:Key="TestResultToItems"/>
        <local:ListToStringConverter x:Key="ListToStr"/>
        <local:BoolToYesNoConverter x:Key="BoolToYesNo"/>
        <local:ObjectToStringConverter x:Key="ObjToStr"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">

            <!-- Page Title -->
            <TextBlock Text="Bilgisayar Sorgula"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,18"/>

            <!-- Query Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="HEDEF BİLGİSAYAR"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding TargetInput, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 FontSize="14"
                                 Height="40"
                                 Margin="0,0,10,0"
                                 VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding GetInfoCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1"
                                Content="🔌  Bağlantıyı Test Et"
                                Command="{Binding TestConnectionCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="40" Margin="0,0,8,0"/>

                        <Button Grid.Column="2"
                                Content="🔍  Bilgileri Getir"
                                Command="{Binding GetInfoCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="40" Margin="0,0,8,0"/>

                        <Button Grid.Column="3"
                                Content="✕  İptal"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Height="40"/>
                    </Grid>

                    <TextBlock Text="IP adresi veya bilgisayar adı giriniz  (örn: 192.168.1.25 veya PC-001)"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11.5"
                               Margin="2,6,0,12"/>

                    <!-- Credentials -->
                    <CheckBox Content="  Windows hesabımı kullan (mevcut kullanıcı)"
                              IsChecked="{Binding UseCurrentUser}"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              Margin="0,0,0,8"/>

                    <Border Visibility="{Binding ShowCredentials, Converter={StaticResource BoolToVis}}"
                            Background="#F5F7FA" CornerRadius="6" Padding="14,10" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Kullanıcı Adı" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Domain (isteğe bağlı)" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Şifre" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="PasswordBox"
                                             Style="{StaticResource ModernPasswordBoxStyle}"
                                             PasswordChanged="PasswordBox_PasswordChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Progress -->
            <Border Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                    Background="White" CornerRadius="8" Padding="20,12" Margin="0,0,0,12">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True"
                                 Style="{StaticResource ModernProgressBarStyle}"
                                 Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ProgressText, Mode=OneWay}"
                               Foreground="{StaticResource PrimaryLightBrush}"
                               FontSize="12.5"/>
                </StackPanel>
            </Border>

            <!-- Connection Test Result -->
            <Border Visibility="{Binding TestResult, Converter={StaticResource NullToVis}}"
                    Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="BAĞLANTI TEST SONUCU"
                               Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding TestResult, Converter={StaticResource TestResultToItems}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,8,0"
                                               Foreground="{Binding IconColor}"/>
                                    <TextBlock Text="{Binding Message}" FontSize="13"
                                               Foreground="{Binding TextColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Suggestions -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestResult.IsFullySuccessful}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Olası nedenler:" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding TestResult.Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2" FontSize="12.5"
                                               Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="•  "/>
                                        <Run Text="{Binding}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status Bar -->
            <Border Background="White" CornerRadius="8" Padding="16,10" Margin="0,0,0,16"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StrToVis}}">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryLightBrush}"/>
            </Border>

            <!-- Results Panel -->
            <Border Visibility="{Binding ComputerInfo, Converter={StaticResource NullToVis}}"
                    Style="{StaticResource CardStyle}" Padding="0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="520"/>
                    </Grid.RowDefinitions>

                    <!-- Summary Header -->
                    <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}"
                            CornerRadius="8,8,0,0" Padding="20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="White" FontSize="16" FontWeight="Bold">
                                    <Run Text="{Binding ComputerInfo.ComputerName}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding ComputerInfo.Target, StringFormat='({0})'}" Foreground="#90CAF9"/>
                                </TextBlock>
                                <TextBlock Foreground="#90CAF9" FontSize="12" Margin="0,2,0,0">
                                    <Run Text="{Binding ComputerInfo.Manufacturer}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding ComputerInfo.Model}"/>
                                    <Run Text="  |  S/N: "/>
                                    <Run Text="{Binding ComputerInfo.SerialNumber}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Export Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="📊 Excel"
                                        Command="{Binding ExportExcelCommand}"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Padding="12,7" Margin="0,0,6,0"/>
                                <Button Content="📄 CSV"
                                        Command="{Binding ExportCsvCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,7" Margin="0,0,6,0"/>
                                <Button Content="📑 PDF"
                                        Command="{Binding ExportPdfCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Padding="12,7"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tabs -->
                    <TabControl Grid.Row="1"
                                Style="{StaticResource ModernTabControlStyle}"
                                SelectedIndex="{Binding SelectedTabIndex}"
                                Background="{StaticResource ContentBgBrush}">

                        <!-- GENEL -->
                        <TabItem Header="🖥  Genel" Style="{StaticResource ModernTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="SİSTEM" Style="{StaticResource SectionHeaderStyle}"/>
                                        <local:InfoRow Label="Bilgisayar Adı" Value="{Binding ComputerInfo.ComputerName}"/>
                                        <local:InfoRow Label="Üretici" Value="{Binding ComputerInfo.Manufacturer}"/>
                                        <local:InfoRow Label="Model" Value="{Binding ComputerInfo.Model}"/>
                                        <local:InfoRow Label="Ürün Adı" Value="{Binding ComputerInfo.ProductName}"/>
                                        <local:InfoRow Label="Seri No" Value="{Binding ComputerInfo.SerialNumber}"/>
                                        <local:InfoRow Label="Sistem Tipi" Value="{Binding ComputerInfo.SystemType}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="KULLANICI &amp; AĞ" Style="{StaticResource SectionHeaderStyle}"/>
                                        <local:InfoRow Label="Domain" Value="{Binding ComputerInfo.Domain}"/>
                                        <local:InfoRow Label="Workgroup" Value="{Binding ComputerInfo.Workgroup}"/>
                                        <local:InfoRow Label="Aktif Kullanıcı" Value="{Binding ComputerInfo.CurrentUser}"/>
                                        <local:InfoRow Label="Son Kullanıcı" Value="{Binding ComputerInfo.LastUser}"/>
                                        <local:InfoRow Label="Sorgu Zamanı" Value="{Binding ComputerInfo.QueryTime, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- CPU -->
                        <TabItem Header="⚙  CPU" Style="{StaticResource ModernTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding ComputerInfo.Cpu.Name}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,0,0,12"/>
                                    <local:InfoRow Label="Üretici" Value="{Binding ComputerInfo.Cpu.Manufacturer}"/>
                                    <local:InfoRow Label="Çekirdek Sayısı" Value="{Binding ComputerInfo.Cpu.Cores}"/>
                                    <local:InfoRow Label="Thread Sayısı" Value="{Binding ComputerInfo.Cpu.Threads}"/>
                                    <local:InfoRow Label="Maks Hız" Value="{Binding ComputerInfo.Cpu.MaxSpeedGhz}"/>
                                    <local:InfoRow Label="Mevcut Hız" Value="{Binding ComputerInfo.Cpu.CurrentSpeedGhz}"/>
                                    <local:InfoRow Label="Mimari" Value="{Binding ComputerInfo.Cpu.Architecture}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- RAM -->
                        <TabItem Header="🧠  RAM" Style="{StaticResource ModernTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                                <StackPanel>
                                    <Border Background="{StaticResource PrimaryLightBrush}"
                                            CornerRadius="8" Padding="16,12" Margin="0,0,0,16"
                                            HorizontalAlignment="Left">
                                        <StackPanel>
                                            <TextBlock Text="TOPLAM RAM"
                                                       FontSize="10" Foreground="#BBDEFB" FontWeight="Bold"/>
                                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="White">
                                                <Run Text="{Binding ComputerInfo.Memory.TotalGb, StringFormat='{}{0:F1}'}"/>
                                                <Run Text=" GB" FontSize="18" Foreground="#BBDEFB"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="BELLEK MODÜLLERI" Style="{StaticResource SectionHeaderStyle}"/>

                                    <ItemsControl ItemsSource="{Binding ComputerInfo.Memory.Slots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" CornerRadius="6" Padding="14,10"
                                                        BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Tag}"
                                                                   FontWeight="SemiBold" FontSize="12.5"
                                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                                        <TextBlock Grid.Column="1" FontSize="12.5"
                                                                   Foreground="{StaticResource TextPrimaryBrush}">
                                                            <Run Text="{Binding Manufacturer}"/>
                                                            <Run Text=" "/>
                                                            <Run Text="{Binding PartNumber}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2" Margin="20,0"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                                            <Run Text="{Binding SpeedMhz}"/>
                                                            <Run Text=" MHz"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="3" FontSize="13" FontWeight="Bold"
                                                                   Foreground="{StaticResource PrimaryBrush}">
                                                            <Run Text="{Binding CapacityGb, StringFormat='{}{0:F1}'}"/>
                                                            <Run Text=" GB"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- DİSKLER -->
                        <TabItem Header="💾  Diskler" Style="{StaticResource ModernTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                                <ItemsControl ItemsSource="{Binding ComputerInfo.Disks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="16">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <Border Background="{StaticResource PrimaryLightBrush}"
                                                                CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding MediaType}"
                                                                       FontSize="11" FontWeight="Bold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Model}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Margin="12,0,0,0" FontSize="12"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="{Binding TotalSizeGb, StringFormat='{}{0:F1}'}"/>
                                                            <Run Text=" GB"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <local:InfoRow Label="Seri No" Value="{Binding SerialNumber}"/>
                                                    <local:InfoRow Label="Arayüz" Value="{Binding InterfaceType}"/>

                                                    <TextBlock Text="MANTIKSAL SÜRÜCÜLER"
                                                               Style="{StaticResource SectionHeaderStyle}"
                                                               Margin="0,10,0,6"/>

                                                    <ItemsControl ItemsSource="{Binding LogicalDisks}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#F8F9FA" CornerRadius="6"
                                                                        Padding="12,8" Margin="0,0,0,6">
                                                                    <StackPanel>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{Binding DriveLetter}"
                                                                                       FontSize="18" FontWeight="Bold"
                                                                                       Foreground="{StaticResource PrimaryBrush}"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding Label}"
                                                                                       FontSize="12.5"
                                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="2" Margin="12,0" FontSize="12"
                                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       VerticalAlignment="Center">
                                                                                <Run Text="Toplam: "/>
                                                                                <Run Text="{Binding TotalSizeGb, StringFormat='{}{0:F1}'}"/>
                                                                                <Run Text=" GB"/>
                                                                            </TextBlock>
                                                                            <TextBlock Grid.Column="3" Margin="12,0" FontSize="12"
                                                                                       Foreground="#F44336" VerticalAlignment="Center">
                                                                                <Run Text="Kullanılan: "/>
                                                                                <Run Text="{Binding UsedSpaceGb, StringFormat='{}{0:F1}'}"/>
                                                                                <Run Text=" GB"/>
                                                                            </TextBlock>
                                                                            <TextBlock Grid.Column="4" FontSize="12"
                                                                                       Foreground="#4CAF50" VerticalAlignment="Center">
                                                                                <Run Text="Boş: "/>
                                                                                <Run Text="{Binding FreeSpaceGb, StringFormat='{}{0:F1}'}"/>
                                                                                <Run Text=" GB"/>
                                                                            </TextBlock>
                                                                        </Grid>
                                                                        <ProgressBar Value="{Binding UsedPercent}"
                                                                                     Maximum="100" Height="5"
                                                                                     Margin="0,6,0,0"
                                                                                     Foreground="{StaticResource PrimaryLightBrush}"
                                                                                     Background="#E3F2FD"
                                                                                     BorderThickness="0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <!-- GPU -->
                        <TabItem Header="🎮  GPU" Style="{StaticResource ModernTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                                <ItemsControl ItemsSource="{Binding ComputerInfo.Gpus}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               Margin="0,0,0,8"/>
                                                    <local:InfoRow Label="Uyumluluk" Value="{Binding AdapterType}"/>
                                                    <local:InfoRow Label="VRAM" Value="{Binding VramText}"/>
                                                    <local:InfoRow Label="Driver Sürümü" Value="{Binding DriverVersion}"/>
                                                    <local:InfoRow Label="Driver Tarihi" Value="{Binding DriverDate}"/>
                                                    <local:InfoRow Label="Durum" Value="{Binding Status}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ANAKART -->
                        <TabItem Header="🔧  Anakart" Style="{StaticResource ModernTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                                <StackPanel>
                                    <local:InfoRow Label="Üretici" Value="{Binding ComputerInfo.Motherboard.Manufacturer}"/>
                                    <local:InfoRow Label="Model" Value="{Binding ComputerInfo.Motherboard.Product}"/>
                                    <local:InfoRow Label="Seri No" Value="{Binding ComputerInfo.Motherboard.SerialNumber}"/>
                                    <local:InfoRow Label="Versiyon" Value="{Binding ComputerInfo.Motherboard.Version}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- BIOS -->
                        <TabItem Header="💡  BIOS" Style="{StaticResource ModernTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                                <StackPanel>
                                    <local:InfoRow Label="Üretici" Value="{Binding ComputerInfo.Bios.Manufacturer}"/>
                                    <local:InfoRow Label="Sürüm" Value="{Binding ComputerInfo.Bios.Version}"/>
                                    <local:InfoRow Label="Çıkış Tarihi" Value="{Binding ComputerInfo.Bios.ReleaseDate}"/>
                                    <local:InfoRow Label="SMBIOS Sürüm" Value="{Binding ComputerInfo.Bios.SMBIOSVersion}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- WINDOWS -->
                        <TabItem Header="🪟  Windows" Style="{StaticResource ModernTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding ComputerInfo.Windows.Caption}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,0,0,12"/>
                                    <local:InfoRow Label="Sürüm" Value="{Binding ComputerInfo.Windows.Version}"/>
                                    <local:InfoRow Label="Build" Value="{Binding ComputerInfo.Windows.BuildNumber}"/>
                                    <local:InfoRow Label="Mimari" Value="{Binding ComputerInfo.Windows.Architecture}"/>
                                    <local:InfoRow Label="Kurulum Tarihi" Value="{Binding ComputerInfo.Windows.InstallDate}"/>
                                    <local:InfoRow Label="Son Açılış" Value="{Binding ComputerInfo.Windows.LastBootTime}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- AĞ -->
                        <TabItem Header="🌐  Ağ" Style="{StaticResource ModernTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                                <ItemsControl ItemsSource="{Binding ComputerInfo.NetworkAdapters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               Margin="0,0,0,8"/>
                                                    <local:InfoRow Label="MAC Adresi" Value="{Binding MacAddress}"/>
                                                    <local:InfoRow Label="IPv4" Value="{Binding IpAddresses, Converter={StaticResource ListToStr}}"/>
                                                    <local:InfoRow Label="IPv6" Value="{Binding IPv6Addresses, Converter={StaticResource ListToStr}}"/>
                                                    <local:InfoRow Label="Gateway" Value="{Binding DefaultGateway}"/>
                                                    <local:InfoRow Label="DHCP" Value="{Binding DhcpEnabled, Converter={StaticResource BoolToYesNo}}"/>
                                                    <local:InfoRow Label="DHCP Sunucu" Value="{Binding DhcpServer}"/>
                                                    <local:InfoRow Label="DNS" Value="{Binding DnsServers, Converter={StaticResource ListToStr}}"/>
                                                    <local:InfoRow Label="Adaptör Tipi" Value="{Binding AdapterType}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <!-- YAZILIMLAR -->
                        <TabItem Header="📦  Yazılımlar" Style="{StaticResource ModernTabItemStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="White"
                                        BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                        Padding="16,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📋  Yazılımları Yükle"
                                                Command="{Binding LoadSoftwareCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="14,7"/>
                                        <TextBlock Margin="16,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12">
                                            <Run Text="{Binding ComputerInfo.InstalledSoftware.Count}"/>
                                            <Run Text=" program listelendi"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding ComputerInfo.InstalledSoftware}"
                                          Style="{StaticResource ModernDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Program Adı" Binding="{Binding Name}" Width="*" MinWidth="200"/>
                                        <DataGridTextColumn Header="Sürüm" Binding="{Binding Version}" Width="120"/>
                                        <DataGridTextColumn Header="Yayıncı" Binding="{Binding Publisher}" Width="180"/>
                                        <DataGridTextColumn Header="Kurulum Tarihi" Binding="{Binding InstallDate}" Width="120"/>
                                        <DataGridTextColumn Header="Mimari" Binding="{Binding Architecture}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                    </TabControl>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
